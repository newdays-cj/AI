+#endif
 
 	/*
 	 * Only initialize the head struct page in memmap_init_reserved_pages,
@@ -3751,14 +3772,50 @@ int __alloc_bootmem_huge_page(struct hstate *h, int nid)
 	 */
 	noinit = memblock_reserved_mark_noinit(virt_to_phys((void *)m + PAGE_SIZE),
 		huge_page_size(h) - PAGE_SIZE);
+#ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+	if (!noinit && boot_pre_hvo_candidate(m)) {
+		unsigned long pfn = PHYS_PFN(virt_to_phys(m));
+		unsigned long start = (unsigned long)pfn_to_page(pfn);
+		unsigned long size = hugetlb_vmemmap_size(h);
+		unsigned long pgtable_bytes;
+		int ret;
+
+		ret = vmemmap_populate_hugetlb(start, start + size,
+					      early_pfn_to_nid(pfn), &pgtable_bytes);
+		/* Even on failure, newly installed empty tables remain reserved. */
+		BUG_ON(pgtable_bytes > boot_hugetlb_metadata_budget);
+		boot_hugetlb_metadata_budget -= pgtable_bytes;
+		if (!ret) {
+			/* The retained head is already reserved: retire all backing. */
+			BUG_ON(size > boot_hugetlb_metadata_budget);
