index 50e522ac183a..c4762b8a640d 100644
--- a/mm/sparse-vmemmap.c
+++ b/mm/sparse-vmemmap.c
@@ -28,6 +28,7 @@
 #include <linux/vmalloc.h>
 #include <linux/sched.h>
 #include <linux/pgalloc.h>
+#include <linux/sizes.h>
 
 #include <asm/dma.h>
 
@@ -303,37 +304,102 @@ int __meminit vmemmap_populate_basepages(unsigned long start, unsigned long end,
 }
 
 #ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+/* Prefer fragments without bypassing the normal mirrored-memory preference. */
+static void * __init vmemmap_alloc_hugetlb(int nid)
+{
+	enum memblock_flags flags = memblock_has_mirror() ? MEMBLOCK_MIRROR :
+		MEMBLOCK_NONE;
+	phys_addr_t start, end, addr;
+	int node = nid;
+	void *p;
+	u64 i;
+
+retry:
+	for_each_free_mem_range(i, node, flags, &start, &end, NULL) {
+		start = ALIGN(max_t(phys_addr_t, start, PAGE_SIZE), PAGE_SIZE);
+		end = round_down(min(end, memblock_get_current_limit()), PAGE_SIZE);
+		if (end <= start)
+			continue;
+		if (!IS_ALIGNED(start, SZ_1G))
+			addr = start;
+		else if (!IS_ALIGNED(end, SZ_1G))
+			addr = round_down(end, SZ_1G);
+		else
+			continue;
+
+		addr = memblock_alloc_range_nid(PAGE_SIZE, PAGE_SIZE,
+				addr, addr + PAGE_SIZE, node, true);
+		if (!addr)
+			return NULL;
+		p = phys_to_virt(addr);
+		memset(p, 0, PAGE_SIZE);
+		return p;
+	}
+	if (node != NUMA_NO_NODE) {
+		node = NUMA_NO_NODE;
+		goto retry;
+	}
+	/* Ordinary allocation exhausts mirrored memory before its fallback. */
+	return vmemmap_alloc_block_zero(PAGE_SIZE, nid);
+}
