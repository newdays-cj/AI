+			pmd_init(p);
+			pud_populate(&init_mm, pud, p);
+		}
+		pmd = pmd_offset(pud, addr);
+		if (pmd_leaf(*pmd))
 			panic("pre-HVO: vmemmap PMD already populated at %lx\n", addr);
-		pmd = vmemmap_pmd_populate(pud, addr, nid);
-		if (!pmd)
-			goto failed;
+		if (pmd_none(*pmd)) {
+			p = vmemmap_alloc_hugetlb(nid);
+			if (!p)
+				goto failed;
+			*pgtable_bytes += PAGE_SIZE;
+			kernel_pte_init(p);
+			pmd_populate_kernel(&init_mm, pmd, p);
+		}
 		if (!pte_none(ptep_get(pte_offset_kernel(pmd, addr))))
 			panic("pre-HVO: vmemmap PTE already populated at %lx\n", addr);
 	}
