+			*pgtable_bytes += PAGE_SIZE;
+			pgd_populate_kernel(addr, pgd, p);
+		}
+		p4d = p4d_offset(pgd, addr);
+		if (p4d_none(*p4d)) {
+			p = vmemmap_alloc_hugetlb(nid);
+			if (!p)
