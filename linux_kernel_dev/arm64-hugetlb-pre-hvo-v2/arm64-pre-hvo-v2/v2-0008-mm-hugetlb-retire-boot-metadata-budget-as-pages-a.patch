 	pfn = PHYS_PFN(__pa(backing));
 
 	/* No aliases may be installed until every fallible allocation is done. */
 	for (addr = start; addr < end; addr += PAGE_SIZE) {
-		pgd_t *pgd = vmemmap_pgd_populate(addr, nid);
+		pgd_t *pgd = pgd_offset_k(addr);
 		p4d_t *p4d;
 		pud_t *pud;
 		pmd_t *pmd;
+		void *p;
 
-		if (!pgd)
-			goto failed;
-		p4d = vmemmap_p4d_populate(pgd, addr, nid);
-		if (!p4d)
-			goto failed;
-		pud = vmemmap_pud_populate(p4d, addr, nid);
-		if (!pud)
-			goto failed;
-		if (pmd_leaf(*pmd_offset(pud, addr)))
+		/* Folded levels never have a missing entry and allocate nothing. */
