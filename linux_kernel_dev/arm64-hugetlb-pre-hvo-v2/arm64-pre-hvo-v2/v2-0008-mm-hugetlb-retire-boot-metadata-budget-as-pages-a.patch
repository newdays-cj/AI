+			m->pre_hvo = true;
+		}
+	}
+	if (boot_pre_hvo_reserving && !m->pre_hvo) {
+		/* An ordinary fallback must fit without prospective HVO credit. */
+		metadata_budget = boot_hugetlb_metadata_budget;
+		mem_usable = memblock_phys_mem_size() - memblock_reserved_size();
+		if (metadata_budget > mem_usable)
