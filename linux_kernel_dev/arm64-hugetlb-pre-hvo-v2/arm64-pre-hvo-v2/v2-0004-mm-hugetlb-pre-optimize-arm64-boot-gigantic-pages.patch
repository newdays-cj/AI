diff --git a/tools/testing/selftests/mm/hugetlb-pre-hvo/init.c b/tools/testing/selftests/mm/hugetlb-pre-hvo/init.c
new file mode 100644
index 000000000000..af8e11332ab4
--- /dev/null
+++ b/tools/testing/selftests/mm/hugetlb-pre-hvo/init.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <linux/kernel-page-flags.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/mount.h>
+#include <sys/reboot.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define POOL "/sys/kernel/mm/hugepages/hugepages-1048576kB/"
+#define SMALL "/sys/kernel/mm/hugepages/hugepages-2048kB/"
+#define GIG (1UL << 30)
+
+static _Noreturn void finish(const char *result, const char *reason)
+{
+	printf("PRE_HVO: %s %s\n", result, reason);
+	fflush(stdout);
+	sync();
+	reboot(RB_POWER_OFF);
+	/* PID 1 must not exit, even when firmware cannot power off. */
+	for (;;)
+		pause();
+}
+
+static _Noreturn void fail(const char *reason)
+{
+	printf("PRE_HVO: errno=%d (%s)\n", errno, strerror(errno));
+	finish("FAIL", reason);
+}
+
+static void caught(int sig)
+{
+	(void)sig;
+	finish("FAIL", "fatal signal while accessing huge page");
+}
+
+static unsigned long number(const char *path)
+{
+	unsigned long value;
+	FILE *f = fopen(path, "r");
+
+	if (!f || fscanf(f, "%lu", &value) != 1)
+		fail(path);
+	fclose(f);
+	printf("PRE_HVO: %s=%lu\n", path, value);
+	return value;
+}
+
+static void store(const char *path, const char *value)
+{
+	int fd = open(path, O_WRONLY);
+	size_t len = strlen(value);
+
+	if (fd < 0 || write(fd, value, len) != (ssize_t)len)
+		fail(path);
+	if (close(fd))
+		fail("close sysfs");
+}
+
+static void equal(const char *path, unsigned long expected)
+{
+	if (number(path) != expected)
+		fail("unexpected pool counter");
+}
+
+static void page_flags(void *mapping)
+{
+	static const unsigned long tails[] = { 1, 64, 4096, 262143 };
+	uint64_t entry, head, tail;
+	size_t i;
+	int pm = open("/proc/self/pagemap", O_RDONLY);
+	int kf = open("/proc/kpageflags", O_RDONLY);
+	off_t offset = ((uintptr_t)mapping / 4096) * sizeof(entry);
+
+	if (pm < 0 || kf < 0) {
+		puts("PRE_HVO: CAPABILITY_SKIP pagemap/kpageflags unavailable");
+		if (pm >= 0)
+			close(pm);
+		if (kf >= 0)
+			close(kf);
+		return;
+	}
+	if (pread(pm, &entry, sizeof(entry), offset) != sizeof(entry) ||
+	    !(entry & (1ULL << 63)))
+		fail("pagemap present bit");
+	entry &= (1ULL << 55) - 1;
+	if (!entry) {
+		puts("PRE_HVO: CAPABILITY_SKIP pagemap PFN hidden");
+	} else {
+		if (pread(kf, &head, sizeof(head), entry * 8) != sizeof(head))
+			fail("read kpageflags");
+		if (!(head & (1ULL << KPF_COMPOUND_HEAD)) ||
+		    !(head & (1ULL << KPF_HUGE)))
+			fail("hugetlb head flags");
+		for (i = 0; i < sizeof(tails) / sizeof(tails[0]); i++) {
+			if (pread(kf, &tail, sizeof(tail), (entry + tails[i]) * 8) != sizeof(tail))
+				fail("read tail kpageflags");
+			printf("PRE_HVO: head_flags=%#" PRIx64 " tail[%lu]=%#" PRIx64 "\n",
+			       head, tails[i], tail);
+			if (!(tail & (1ULL << KPF_COMPOUND_TAIL)) ||
+			    !(tail & (1ULL << KPF_HUGE)) ||
+			    (tail & (1ULL << KPF_COMPOUND_HEAD)))
+				fail("hugetlb tail flags");
+		}
+	}
+	close(pm);
+	close(kf);
+}
+
+int main(void)
+{
+	char cmdline[4096], test[32] = "lifecycle", *token, *save;
+	unsigned long expected = 1, nodes = 1, i;
+	volatile uint64_t *mapping;
+	FILE *f;
+
+	setvbuf(stdout, NULL, _IONBF, 0);
+	signal(SIGBUS, caught);
+	signal(SIGSEGV, caught);
+	if (getpid() != 1)
+		return 1;
+	if (mount("proc", "/proc", "proc", 0, NULL) ||
+	    mount("sysfs", "/sys", "sysfs", 0, NULL))
+		fail("mount proc/sysfs");
+	f = fopen("/proc/cmdline", "r");
+	if (!f || !fgets(cmdline, sizeof(cmdline), f))
+		fail("read cmdline");
+	fclose(f);
+	printf("PRE_HVO: cmdline=%s\n", cmdline);
+	for (token = strtok_r(cmdline, " \n", &save); token;
+	     token = strtok_r(NULL, " \n", &save)) {
+		if (!strncmp(token, "pre_hvo.expected=", 17)) {
+			char *end;
+
+			errno = 0;
+			expected = strtoul(token + 17, &end, 10);
+			if (errno || *end)
+				fail("invalid expected count");
+		}
+		if (!strncmp(token, "pre_hvo.case=", 13))
+			snprintf(test, sizeof(test), "%s", token + 13);
+		if (!strncmp(token, "pre_hvo.nodes=", 14))
+			nodes = strtoul(token + 14, NULL, 10);
+	}
+	if (sysconf(_SC_PAGESIZE) != 4096)
+		finish("SKIP", "requires 4 KiB base pages");
+	if (access(POOL "nr_hugepages", F_OK))
+		finish("SKIP", "1 GiB huge pages unavailable");
+	if (strcmp(test, "lifecycle") && strcmp(test, "nohuge") && strcmp(test, "demote"))
+		fail("unknown case");
+	equal(POOL "nr_hugepages", expected);
+	equal(POOL "free_hugepages", expected);
+	if (nodes == 2) {
+		char path[160];
+		unsigned long total = 0;
+
+		for (i = 0; i < nodes; i++) {
+			snprintf(path, sizeof(path), "/sys/devices/system/node/node%lu/"
+				 "hugepages/hugepages-1048576kB/nr_hugepages", i);
+			if (access(path, F_OK))
+				finish("SKIP", "NUMA node pool unavailable");
+			total += number(path);
+		}
+		if (total != expected)
+			fail("NUMA pool sum");
+	}
+	if (!strcmp(test, "nohuge")) {
+		if (expected)
+			fail("nohuge requires expected=0");
+		mapping = mmap(NULL, GIG, PROT_READ | PROT_WRITE,
+			       MAP_PRIVATE | MAP_ANONYMOUS | MAP_HUGETLB |
+			       (30 << MAP_HUGE_SHIFT), -1, 0);
+		if (mapping != MAP_FAILED || errno != ENOMEM)
+			fail("empty pool mmap did not fail with ENOMEM");
+		finish("PASS", "nohuge");
+	}
+	if (!expected)
+		fail("mapping case requires a nonempty pool");
+	mapping = mmap(NULL, GIG, PROT_READ | PROT_WRITE,
+		       MAP_PRIVATE | MAP_ANONYMOUS | MAP_HUGETLB |
+		       (30 << MAP_HUGE_SHIFT), -1, 0);
+	if (mapping == MAP_FAILED)
+		fail("mmap 1 GiB");
+	/* Check both ends of every base page, including the last byte of 1 GiB. */
+	for (i = 0; i < GIG / sizeof(*mapping); i += 4096 / sizeof(*mapping)) {
+		mapping[i] = 0x123456789abcdef0ULL ^ i;
+		mapping[i + 511] = ~mapping[i];
+	}
+	for (i = 0; i < GIG / sizeof(*mapping); i += 4096 / sizeof(*mapping))
+		if (mapping[i] != (0x123456789abcdef0ULL ^ i) ||
+		    mapping[i + 511] != ~(0x123456789abcdef0ULL ^ i))
+			fail("data mismatch");
+	puts("PRE_HVO: pattern check across 1 GiB passed");
+	equal(POOL "free_hugepages", expected - 1);
+	page_flags((void *)mapping);
+	if (munmap((void *)mapping, GIG))
+		fail("munmap");
+	equal(POOL "free_hugepages", expected);
+	if (!strcmp(test, "demote")) {
+		unsigned long small;
+
+		if (access(POOL "demote", F_OK))
+			finish("SKIP", "demote interface unavailable");
+		store(POOL "demote_size", "2M");
+		equal(POOL "demote_size", 2048);
+		small = number(SMALL "nr_hugepages");
+		store(POOL "demote", "1");
+		equal(POOL "nr_hugepages", expected - 1);
+		equal(SMALL "nr_hugepages", small + 512);
+		store(SMALL "nr_hugepages", "0");
+		equal(SMALL "nr_hugepages", 0);
+		equal(SMALL "free_hugepages", 0);
+	}
+	store(POOL "nr_hugepages", "0");
+	equal(POOL "nr_hugepages", 0);
+	equal(POOL "free_hugepages", 0);
+	equal(POOL "surplus_hugepages", 0);
+	finish("PASS", test);
+	return 0;
+}
diff --git a/tools/testing/selftests/mm/hugetlb-pre-hvo/run.sh b/tools/testing/selftests/mm/hugetlb-pre-hvo/run.sh
new file mode 100644
index 000000000000..2233f3fc397d
--- /dev/null
+++ b/tools/testing/selftests/mm/hugetlb-pre-hvo/run.sh
@@ -0,0 +1,89 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+set -eu
+
+if [ "$#" -ne 3 ]; then
+	echo "Usage: sh $0 IMAGE GEN_INIT_CPIO LOG" >&2
+	echo "Environment: CASE=lifecycle|nohuge|demote HVO=on|off EXPECTED_POOL=1 TIMEOUT=300 EXPECT_LOG='literal text'" >&2
+	echo "             REQUESTED_POOL=EXPECTED_POOL EXTRA_CMDLINE='kernel parameters' MEMORY=3072 (MiB) CPUS=2 NODES=1|2" >&2
+	exit 2
+fi
+kernel=$(realpath "$1")
+cpio=$(realpath "$2")
+log=$3
+src=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+case_name=${CASE:-lifecycle}
+hvo=${HVO:-on}
+expected=${EXPECTED_POOL:-1}
+requested=${REQUESTED_POOL:-$expected}
+memory=${MEMORY:-3072}
+cpus=${CPUS:-2}
+nodes=${NODES:-1}
+for value in "$memory" "$cpus"; do
+	case "$value" in
+		''|0*|*[!0-9]*)
+			echo 'MEMORY and CPUS must be positive decimal integers (no leading zeros)' >&2
+			exit 2
+			;;
+	esac
+done
+case "$case_name" in lifecycle|nohuge|demote) ;; *) exit 2 ;; esac
+case "$hvo" in on|off) ;; *) exit 2 ;; esac
+case "$expected" in ''|*[!0-9]*) exit 2 ;; esac
+case "$requested" in ''|*[!0-9:,]*) exit 2 ;; esac
+case "$nodes" in 1|2) ;; *) exit 2 ;; esac
+if [ "$nodes" = 2 ] && { [ "$((memory % 2))" -ne 0 ] || [ "$((cpus % 2))" -ne 0 ]; }; then
+	echo 'Two NUMA nodes require even MEMORY and CPUS values' >&2
+	exit 2
+fi
+if [ "$case_name" = nohuge ] && [ "$expected" != 0 ]; then
+	echo 'nohuge requires EXPECTED_POOL=0' >&2
+	exit 2
+fi
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+"${CC:-aarch64-linux-gnu-gcc}" -O2 -static -Wall -Wextra -Werror \
+	-o "$tmp/init" "$src/init.c"
+printf 'dir /proc 0555 0 0\ndir /sys 0555 0 0\nfile /init %s 0755 0 0\n' \
+	"$tmp/init" > "$tmp/list"
+"$cpio" "$tmp/list" > "$tmp/initramfs.cpio"
+append="console=ttyAMA0 earlycon=pl011,0x9000000 rdinit=/init panic=-1 hugepagesz=1G hugepages=$requested hugetlb_free_vmemmap=$hvo pre_hvo.expected=$expected pre_hvo.case=$case_name pre_hvo.nodes=$nodes"
+if [ -n "${EXTRA_CMDLINE:-}" ]; then
+	append="$append $EXTRA_CMDLINE"
+fi
+printf 'Image: %s\nCommand line: %s\n' "$kernel" "$append"
+printf 'Guest memory: %s MiB; CPUs: %s; NUMA nodes: %s\n' "$memory" "$cpus" "$nodes"
+set -- -machine virt -cpu max -m "$memory" -smp "$cpus" -nographic -no-reboot -monitor none
+if [ "$nodes" = 2 ]; then
+	set -- "$@" \
+		-object "memory-backend-ram,id=ram0,size=$((memory / 2))M" \
+		-object "memory-backend-ram,id=ram1,size=$((memory / 2))M" \
+		-numa "node,nodeid=0,memdev=ram0,cpus=0-$((cpus / 2 - 1))" \
+		-numa "node,nodeid=1,memdev=ram1,cpus=$((cpus / 2))-$((cpus - 1))"
+fi
+status=0
+timeout --kill-after=10 "${TIMEOUT:-300}" "${QEMU:-qemu-system-aarch64}" \
+	"$@" -kernel "$kernel" -initrd "$tmp/initramfs.cpio" \
+	-append "$append" > "$log" 2>&1 || status=$?
+cat "$log"
+tr -d '\r' < "$log" > "$tmp/check.log"
+if [ "$status" -ne 0 ]; then
+	echo "QEMU failed or timed out: status=$status" >&2
+	exit 1
+fi
+if grep -Eq 'PRE_HVO: FAIL|Kernel panic|BUG:|WARNING:|Oops:|Unable to handle kernel' "$log"; then
+	echo 'Guest failure or kernel diagnostic detected' >&2
+	exit 1
+fi
+if grep -Eq '^PRE_HVO: SKIP ' "$log"; then
+	echo 'Guest capability skip (not a pass)' >&2
+	exit 4
+fi
+if ! grep -qx "PRE_HVO: PASS $case_name" "$tmp/check.log"; then
+	echo 'Missing guest PASS marker' >&2
+	exit 1
+fi
+if [ -n "${EXPECT_LOG:-}" ] && ! grep -Fq -- "$EXPECT_LOG" "$log"; then
+	echo 'Missing requested kernel log text' >&2
+	exit 1
+fi
