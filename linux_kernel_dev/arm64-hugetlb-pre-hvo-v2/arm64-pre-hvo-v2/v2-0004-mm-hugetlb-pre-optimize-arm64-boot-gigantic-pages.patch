 {
 	unsigned long min, max;
+	unsigned long max_zone_pfns[MAX_NR_ZONES] = { 0 };
+	bool pre_hvo;
 
 	min = PFN_UP(memblock_start_of_DRAM());
 	max = PFN_DOWN(memblock_end_of_DRAM());
@@ -579,12 +578,26 @@ void __init bootmem_init(void)
 
 	kvm_hyp_reserve();
 
+	pre_hvo = hugetlb_bootmem_pre_hvo_enable();
+	if (pre_hvo) {
+		/* Keep these reservations ahead of the gigantic HugeTLB pool. */
+		zone_sizes_init(max_zone_pfns);
+		dma_contiguous_reserve(arm64_dma_phys_limit);
+		reserve_crashkernel();
+		reserve_memmap_regions();
+		folio_cma_reserve();
+	}
+
 	/*
 	 * sparse_init() tries to allocate memory from memblock, so must be
 	 * done after the fixed reservations
 	 */
 	sparse_init();
-	zone_sizes_init();
+	if (!pre_hvo)
+		zone_sizes_init(max_zone_pfns);
+	free_area_init(max_zone_pfns);
+	if (pre_hvo)
+		goto out;
 
 	/*
 	 * Reserve the CMA area after arm64_dma_phys_limit was initialised.
@@ -600,6 +613,7 @@ void __init bootmem_init(void)
 	reserve_memmap_regions();
 	folio_cma_reserve();
 
+out:
 	memblock_dump_all();
 }
 
