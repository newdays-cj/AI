+static bool boot_pre_hvo_reserving __initdata;
+static char boot_hugetlb_params[COMMAND_LINE_SIZE] __initdata;
+static unsigned int boot_hugetlb_params_len __initdata;
+static bool boot_hugetlb_params_overflow __initdata;
+static bool boot_hugetlb_has_gigantic __initdata;
+static bool boot_hugetlb_has_count __initdata;
+
+enum boot_hugetlb_param {
+	BOOT_HUGEPAGES = 1,
+	BOOT_HUGEPAGESZ,
+	BOOT_DEFAULT_HUGEPAGESZ,
+};
+
+static int __init boot_hugetlb_param_save(char *s, enum boot_hugetlb_param type)
+{
+	size_t len;
+
+	if (!s)
+		return 0;
+	len = strlen(s) + 1;
+	if (boot_hugetlb_params_len + len + 1 > sizeof(boot_hugetlb_params)) {
+		boot_hugetlb_params_overflow = true;
+		return 0;
+	}
+	boot_hugetlb_params[boot_hugetlb_params_len++] = type;
+	memcpy(boot_hugetlb_params + boot_hugetlb_params_len, s, len);
+	boot_hugetlb_params_len += len;
+	if (type == BOOT_HUGEPAGES)
+		boot_hugetlb_has_count = true;
+	else if (memparse(s, NULL) == SZ_1G)
+		boot_hugetlb_has_gigantic = true;
+	return 0;
+}
+
+static int __init boot_hugepages_save(char *s)
+{
+	return boot_hugetlb_param_save(s, BOOT_HUGEPAGES);
+}
+early_param("hugepages", boot_hugepages_save);
+
+static int __init boot_hugepagesz_save(char *s)
+{
+	return boot_hugetlb_param_save(s, BOOT_HUGEPAGESZ);
+}
+early_param("hugepagesz", boot_hugepagesz_save);
+
+static int __init boot_default_hugepagesz_save(char *s)
+{
+	return boot_hugetlb_param_save(s, BOOT_DEFAULT_HUGEPAGESZ);
+}
+early_param("default_hugepagesz", boot_default_hugepagesz_save);
+
+bool __init hugetlb_bootmem_pre_hvo_enable(void)
+{
+	boot_pre_hvo = hugetlb_vmemmap_boot_enabled() && !hugetlb_cma_size &&
+		!boot_hugetlb_params_overflow && boot_hugetlb_has_gigantic &&
+		boot_hugetlb_has_count && is_power_of_2(sizeof(struct page)) &&
+		SZ_1G / PAGE_SIZE >= PAGES_PER_SECTION;
+	return boot_pre_hvo;
+}
+
+bool __init hugetlb_bootmem_pre_hvo_enabled(void)
+{
+	return boot_pre_hvo;
+}
+
+/* Called only for MEMINIT_EARLY, including when memory hotplug is built. */
+unsigned long __ref hugetlb_bootmem_pre_hvo_skip(unsigned long pfn)
+{
+	static unsigned long cached_start __initdata = ULONG_MAX;
+	static unsigned long cached_end __initdata;
+	unsigned long start = round_down(pfn, SZ_1G / PAGE_SIZE);
+	struct huge_bootmem_page *m;
+
+	if (!boot_pre_hvo)
+		return pfn;
+	if (cached_start != start) {
+		cached_start = start;
+		cached_end = 0;
+		list_for_each_entry(m, &huge_boot_pages, list) {
+			if (m->pre_hvo && PHYS_PFN(virt_to_phys(m)) == start) {
+				cached_end = start + SZ_1G / PAGE_SIZE;
+				break;
+			}
+		}
+	}
+	if (cached_end && pfn >= start + HUGETLB_VMEMMAP_RESERVE_PAGES)
+		return cached_end;
+	return pfn;
+}
+
+static bool __init boot_pre_hvo_candidate(struct huge_bootmem_page *m)
+{
+	unsigned long pfn = PHYS_PFN(virt_to_phys(m));
+	unsigned long end = pfn + SZ_1G / PAGE_SIZE;
+	int nid = early_pfn_to_nid(pfn), i;
+	bool found = false;
+
+	if (!boot_pre_hvo_reserving || huge_page_size(m->hstate) != SZ_1G)
+		return false;
+	/* A shared descriptor must not describe two different nodes or zones. */
+	for (i = 0; i < MAX_NR_ZONES; i++) {
+		struct zone *zone = &NODE_DATA(nid)->node_zones[i];
+
+		if (!populated_zone(zone) || zone_end_pfn(zone) <= pfn ||
+		    zone->zone_start_pfn >= end)
+			continue;
+		if (!zone_spans_pfn(zone, pfn) || !zone_spans_pfn(zone, end - 1))
+			return false;
+		found = true;
+	}
+	return found && early_pfn_to_nid(end - 1) == nid;
+}
+#endif
 
 /*
  * Protects updates to hugepage_freelists, hugepage_activelist, nr_huge_pages,
@@ -2247,6 +2369,7 @@ static bool __ref huge_page_limit_check(int type, size_t hsize, int nid)
 
 	if (type == HUGE_PAGE_BOOTMEM_ALLOC) {
 		mem_usable = memblock_phys_mem_size() - memblock_reserved_size();
+		mem_usable -= min_t(u64, mem_usable, boot_hugetlb_metadata_budget);
 		str = "memblock usable";
 	} else if (type == HUGE_PAGE_FRESH_ALLOC) {
 		mem_usable = nr_free_pages() << PAGE_SHIFT;
@@ -3494,12 +3617,80 @@ struct folio *alloc_hugetlb_folio(struct vm_area_struct *vma,
 	return ERR_PTR(-ENOSPC);
 }
 
+#ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+static void *__init alloc_bootmem_huge_page_zone(phys_addr_t size,
+		phys_addr_t align, phys_addr_t min_addr, phys_addr_t max_addr,
+		int nid, enum memblock_flags flags)
+{
+	phys_addr_t start, end, best = 0;
+	u64 i;
+	int zid;
+
+	max_addr = max_addr ? min(max_addr, memblock_get_current_limit()) :
+		memblock_get_current_limit();
+	for_each_free_mem_range(i, nid, flags, &start, &end, NULL) {
+		for (zid = 0; zid < MAX_NR_ZONES; zid++) {
+			struct zone *zone = &NODE_DATA(nid)->node_zones[zid];
+			phys_addr_t lower, upper, addr;
+
+			if (!populated_zone(zone))
+				continue;
+			lower = max3(start, min_addr, PFN_PHYS(zone->zone_start_pfn));
+			upper = min3(end, max_addr, PFN_PHYS(zone_end_pfn(zone)));
+			if (upper <= lower || upper - lower < size)
+				continue;
+			addr = memblock_bottom_up() ? ALIGN(lower, align) :
+				round_down(upper - size, align);
+			if (addr < lower || addr > upper - size)
+				continue;
+			if (!best || (memblock_bottom_up() ? addr < best : addr > best))
+				best = addr;
+		}
+	}
+	if (!best)
+		return NULL;
+	best = memblock_alloc_range_nid(size, align, best, best + size, nid, true);
+	return best ? phys_to_virt(best) : NULL;
+}
+
+static void *__init alloc_bootmem_huge_page_zoned(phys_addr_t size,
+		phys_addr_t align, phys_addr_t min_addr, phys_addr_t max_addr, int nid)
+{
+	enum memblock_flags flags = mem_reliable_is_enabled() ? MEMBLOCK_NOMIRROR :
+		(memblock_has_mirror() ? MEMBLOCK_MIRROR : MEMBLOCK_NONE);
+	void *page;
+	int node;
+
+retry:
+	page = alloc_bootmem_huge_page_zone(size, align, min_addr, max_addr, nid, flags);
+	if (page)
+		return page;
+	for_each_node_state(node, N_MEMORY) {
+		if (node == nid)
+			continue;
+		page = alloc_bootmem_huge_page_zone(size, align, min_addr, max_addr,
+						  node, flags);
+		if (page)
+			return page;
+	}
+	if (flags == MEMBLOCK_MIRROR) {
+		flags = MEMBLOCK_NONE;
+		goto retry;
+	}
+	return NULL;
+}
+#endif
+
 static void *__init __alloc_bootmem_huge_page_inner(phys_addr_t size,
 						    phys_addr_t align,
 						    phys_addr_t min_addr,
 						    phys_addr_t max_addr,
 						    int nid)
 {
+#ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+	if (boot_pre_hvo_reserving)
+		return alloc_bootmem_huge_page_zoned(size, align, min_addr, max_addr, nid);
+#endif
 	if (!mem_reliable_is_enabled())
 		return memblock_alloc_try_nid_raw(size, align, min_addr,
 						  max_addr, nid);
@@ -3514,6 +3705,12 @@ int __alloc_bootmem_huge_page(struct hstate *h, int nid)
 {
 	struct huge_bootmem_page *m = NULL; /* initialize for clang */
 	int nr_nodes, node;
+	int noinit __maybe_unused;
+
+	if (boot_hugetlb_metadata_budget &&
+	    memblock_phys_mem_size() - memblock_reserved_size() <
+	    boot_hugetlb_metadata_budget + huge_page_size(h))
+		return 0;
 
 #ifdef CONFIG_HUGETLB_ALLOC_LIMIT
 	if (!huge_page_limit_check(HUGE_PAGE_BOOTMEM_ALLOC, huge_page_size(h), nid))
@@ -3552,12 +3749,15 @@ int __alloc_bootmem_huge_page(struct hstate *h, int nid)
 	 * The head struct page is used to get folio information by the HugeTLB
 	 * subsystem like zone id and node id.
 	 */
-	memblock_reserved_mark_noinit(virt_to_phys((void *)m + PAGE_SIZE),
+	noinit = memblock_reserved_mark_noinit(virt_to_phys((void *)m + PAGE_SIZE),
 		huge_page_size(h) - PAGE_SIZE);
 	/* Put them into a private list first because mem_map is not up yet */
 	INIT_LIST_HEAD(&m->list);
 	list_add(&m->list, &huge_boot_pages);
 	m->hstate = h;
+#ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+	m->pre_hvo = !noinit && boot_pre_hvo_candidate(m);
+#endif
 	return 1;
 }
 
@@ -3616,6 +3816,16 @@ static void __init gather_bootmem_prealloc(void)
 
 		hugetlb_folio_init_vmemmap(folio, h,
 					   HUGETLB_VMEMMAP_RESERVE_PAGES);
+#ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+		if (m->pre_hvo) {
+			unsigned long pfn = folio_pfn(folio);
+			unsigned long end = pfn + pages_per_huge_page(h);
+
+			hugetlb_vmemmap_boot_finish(h, page);
+			for (; pfn < end; pfn += pageblock_nr_pages)
+				set_pageblock_migratetype(pfn_to_page(pfn), MIGRATE_MOVABLE);
+		}
+#endif
 		prep_new_hugetlb_folio(h, folio, folio_nid(folio));
 		/* If HVO fails, initialize all tail struct pages */
 		if (!HPageVmemmapOptimized(&folio->page))
@@ -4821,6 +5031,9 @@ static int __init hugepages_setup(char *s)
 	unsigned long tmp;
 	char *p = s;
 
+	if (boot_hugetlb_params_done)
+		return 1;
+
 	if (!parsed_valid_hugepagesz) {
 		pr_warn("HugeTLB: hugepages=%s does not follow a valid hugepagesz, ignoring\n", s);
 		parsed_valid_hugepagesz = true;
@@ -4909,6 +5122,9 @@ static int __init hugepagesz_setup(char *s)
 	unsigned long size;
 	struct hstate *h;
 
+	if (boot_hugetlb_params_done)
+		return 1;
+
 	parsed_valid_hugepagesz = false;
 	size = (unsigned long)memparse(s, NULL);
 
@@ -4957,6 +5173,9 @@ static int __init default_hugepagesz_setup(char *s)
 	unsigned long size;
 	int i;
 
+	if (boot_hugetlb_params_done)
+		return 1;
+
 	parsed_valid_hugepagesz = false;
 	if (parsed_default_hugepagesz) {
 		pr_err("HugeTLB: default_hugepagesz previously specified, ignoring %s\n", s);
@@ -4996,6 +5215,59 @@ static int __init default_hugepagesz_setup(char *s)
 }
 __setup("default_hugepagesz=", default_hugepagesz_setup);
 
+#ifdef CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_BOOT
+void __init hugetlb_bootmem_pre_hvo_prepare(void)
+{
+	struct huge_bootmem_page *m;
+	unsigned int pos = 0;
+	unsigned long nr = 0, saved = 0;
+
+	if (!boot_pre_hvo)
+		return;
+
+	boot_hugetlb_metadata_budget = sparse_boot_memmap_size();
+	boot_pre_hvo_reserving = true;
+	while (pos < boot_hugetlb_params_len) {
+		enum boot_hugetlb_param type = boot_hugetlb_params[pos++];
+		char *s = boot_hugetlb_params + pos;
+
+		pos += strlen(s) + 1;
+		switch (type) {
+		case BOOT_HUGEPAGES:
+			hugepages_setup(s);
+			break;
+		case BOOT_HUGEPAGESZ:
+			hugepagesz_setup(s);
+			break;
+		case BOOT_DEFAULT_HUGEPAGESZ:
+			default_hugepagesz_setup(s);
+			break;
+		}
+	}
+	boot_pre_hvo_reserving = false;
+	boot_hugetlb_params_done = true;
+	boot_hugetlb_metadata_budget = 0;
+
+	list_for_each_entry(m, &huge_boot_pages, list) {
+		unsigned long start = (unsigned long)pfn_to_page(PHYS_PFN(virt_to_phys(m)));
+		unsigned long size = hugetlb_vmemmap_size(m->hstate);
+
+		if (!m->pre_hvo)
+			continue;
+		if (vmemmap_populate_hugetlb(start, start + size,
+					    early_pfn_to_nid(PHYS_PFN(virt_to_phys(m))))) {
+			m->pre_hvo = false;
+			continue;
+		}
+		nr++;
+		saved += size - HUGETLB_VMEMMAP_RESERVE_SIZE;
+	}
+	sparse_boot_memmap_populate();
+	pr_info("HugeTLB: pre-HVO: %lu 1GB pages, %lu vmemmap backing pages saved (%lu bytes)\n",
+		nr, saved >> PAGE_SHIFT, saved);
+}
+#endif
+
 static unsigned int allowed_mems_nr(struct hstate *h)
 {
 	int node;
diff --git a/mm/mm_init.c b/mm/mm_init.c
index 6dc3c385c637..d79a5dfc5734 100644
--- a/mm/mm_init.c
+++ b/mm/mm_init.c
@@ -27,6 +27,7 @@
 #include <linux/swap.h>
 #include <linux/cma.h>
 #include <linux/crash_dump.h>
+#include <linux/hugetlb.h>
 #include "internal.h"
 #include "slab.h"
 #include "shuffle.h"
@@ -920,8 +921,16 @@ void __meminit memmap_init_range(unsigned long size, int nid, unsigned long zone
 		 * function.  They do not exist on hotplugged memory.
 		 */
 		if (context == MEMINIT_EARLY) {
+			unsigned long next_pfn;
+
 			if (overlap_memmap_init(zone, &pfn))
 				continue;
+			/* Aliased tails are initialized through their retained page. */
+			next_pfn = hugetlb_bootmem_pre_hvo_skip(pfn);
+			if (next_pfn != pfn) {
+				pfn = next_pfn;
+				continue;
+			}
