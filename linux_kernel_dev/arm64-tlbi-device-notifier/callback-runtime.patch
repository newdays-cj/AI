+void
+__mmu_notifier_arch_invalidate_secondary_tlbs_post_tlbi(struct mm_struct *mm,
+							unsigned long start,
+							unsigned long end,
+							bool need_tlb)
+{
+	struct mmu_notifier *subscription;
+	int id;
+
+	id = srcu_read_lock(&srcu);
+	hlist_for_each_entry_rcu(subscription,
+				 &mm->notifier_subscriptions->list, hlist,
+				 srcu_read_lock_held(&srcu)) {
+		const struct mmu_notifier_ops *ops = subscription->ops;
+
+		if (need_tlb && ops->arch_invalidate_secondary_tlbs_conditional)
+			ops->arch_invalidate_secondary_tlbs_conditional(subscription,
+								  mm, start, end);
+		if (ops->arch_invalidate_secondary_tlbs)
+			ops->arch_invalidate_secondary_tlbs(subscription, mm,
+							    start, end);
+	}
+	srcu_read_unlock(&srcu, id);
+}
+EXPORT_SYMBOL_IF_KUNIT(__mmu_notifier_arch_invalidate_secondary_tlbs_post_tlbi);
