--- /dev/null
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3-sva-test.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef ARM_SMMU_V3_SVA_TEST_H
+#define ARM_SMMU_V3_SVA_TEST_H
+
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct arm_smmu_domain;
+struct arm_smmu_device;
+struct mmu_notifier_ops;
+
+#if IS_ENABLED(CONFIG_KUNIT)
+#include <kunit/resource.h>
+#include <kunit/test-bug.h>
+#include <linux/preempt.h>
+
+#define ARM_SMMU_SVA_TEST_RESOURCE "arm-smmu-sva-callback-scope"
+
+struct arm_smmu_sva_test_scope {
+	struct arm_smmu_device *smmu;
+	struct arm_smmu_domain *domain;
+	bool run_enabled;
+};
+
+static inline bool arm_smmu_sva_test_owns(const struct arm_smmu_device *smmu,
+					  const struct arm_smmu_domain *domain)
+{
+	struct arm_smmu_sva_test_scope *scope;
+	struct kunit_resource *res;
+	struct kunit *test;
+	bool owns;
+
+	if (!in_task())
+		return false;
+
+	test = kunit_get_current_test();
+	if (!test)
+		return false;
+	if ((!smmu && !domain) || (smmu && domain))
+		return false;
+
+	res = kunit_find_named_resource(test, ARM_SMMU_SVA_TEST_RESOURCE);
+	if (!res)
+		return false;
+
+	scope = res->data;
+	owns = scope->run_enabled &&
+		(smmu ? scope->smmu == smmu : scope->domain == domain);
+	kunit_put_resource(res);
+	return owns;
+}
+
+size_t arm_smmu_sva_invalidate_size(struct arm_smmu_domain *smmu_domain,
+				    unsigned long start, unsigned long end);
+const struct mmu_notifier_ops *arm_smmu_sva_test_notifier_ops(bool conditional);
+#endif
+
+#endif /* ARM_SMMU_V3_SVA_TEST_H */
