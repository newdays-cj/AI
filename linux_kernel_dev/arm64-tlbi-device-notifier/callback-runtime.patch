+#include <kunit/visibility.h>
 
 /* global SRCU for all MMs */
 DEFINE_STATIC_SRCU(srcu);
@@ -603,6 +604,40 @@ void __mmu_notifier_arch_invalidate_secondary_tlbs(struct mm_struct *mm,
