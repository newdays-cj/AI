new file mode 100644
index 000000000000..8ffa3859ba9f
--- /dev/null
+++ b/mm/reserved_va.c
@@ -0,0 +1,239 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/init.h>
+#include <linux/mutex.h>
+#include <linux/reserved_va.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task.h>
+
+struct reserved_va_range {
+	unsigned long start;
+	unsigned long end;
+};
+
+static struct reserved_va_range ranges[RESERVED_VA_NR] __ro_after_init;
+static bool frozen __ro_after_init;
+static DEFINE_MUTEX(registration_lock);
+
+/**
+ * reserved_va_register - reserve a native ARM64 user virtual address range
+ * @id: range number, 0 through 7
+ * @start: inclusive, page-aligned start address
+ * @end: exclusive, page-aligned end address
+ *
+ * Built-in callers must register synchronously by fs_initcall. Ranges are
+ * immutable after fs_initcall_sync, before usermode helpers are enabled.
+ * No physical memory or per-process VMA is allocated. Not exported to modules.
+ *
+ * Return: 0, -EPERM after freezing, -EINVAL for invalid input, or -EEXIST
+ * for a duplicate number or intersecting range.
+ */
+int reserved_va_register(unsigned int id, unsigned long start, unsigned long end)
+{
+	int i, ret = 0;
+
+	mutex_lock(&registration_lock);
+	if (frozen) {
+		ret = -EPERM;
+		goto out;
+	}
+	if (id >= RESERVED_VA_NR || start < PAGE_SIZE || start >= end ||
+	    end > TASK_SIZE_64 || offset_in_page(start | end)) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (ranges[id].end) {
+		ret = -EEXIST;
+		goto out;
+	}
+	for (i = 0; i < RESERVED_VA_NR; i++) {
+		if (start < ranges[i].end && end > ranges[i].start) {
+			ret = -EEXIST;
+			goto out;
+		}
+	}
+	ranges[id].start = start;
+	ranges[id].end = end;
+out:
+	mutex_unlock(&registration_lock);
+	return ret;
+}
+
+static int __init reserved_va_freeze(void)
+{
+	mutex_lock(&registration_lock);
+	frozen = true;
+	mutex_unlock(&registration_lock);
+	return 0;
+}
+fs_initcall_sync(reserved_va_freeze);
+
+vm_flags_t reserved_va_vm_flags(unsigned long flags)
+{
+	if (!(flags & MAP_RESERVED_VA))
+		return 0;
+	return (((flags & MAP_RESERVED_VA_MASK) >> MAP_RESERVED_VA_SHIFT) + 1)
+		<< VM_RESERVED_VA_SHIFT;
+}
+
+unsigned long reserved_va_map_flags(vm_flags_t flags)
+{
+	unsigned long n = (flags & VM_RESERVED_VA_MASK) >> VM_RESERVED_VA_SHIFT;
+
+	return n ? MAP_RESERVED_VA_ID(n - 1) : 0;
+}
+
+int reserved_va_check(struct mm_struct *mm, unsigned long start,
+		      unsigned long len, vm_flags_t flags)
+{
+	unsigned long n = (flags & VM_RESERVED_VA_MASK) >> VM_RESERVED_VA_SHIFT;
+	unsigned long end = start + len;
+	int i;
+
+	if (mm->context.flags & MMCF_AARCH32)
+		return n ? -EOPNOTSUPP : 0;
+	if (!len)
+		return 0;
+	if (end < start)
+		return -EINVAL;
+	if (n) {
+		if (n > RESERVED_VA_NR)
+			return -EINVAL;
+		if (!ranges[n - 1].end)
+			return -ENODEV;
+		return start >= ranges[n - 1].start && end <= ranges[n - 1].end ?
+			0 : -EINVAL;
+	}
+	for (i = 0; i < RESERVED_VA_NR; i++)
+		if (start < ranges[i].end && end > ranges[i].start)
+			return -EINVAL;
+	return 0;
+}
+
+unsigned long reserved_va_get_area(reserved_va_get_area_t get_area,
+				   struct file *file, unsigned long addr,
+				   unsigned long len, unsigned long pgoff,
+				   unsigned long flags)
+{
+	vm_flags_t vm_flags = reserved_va_vm_flags(flags);
+	unsigned long saved, ret;
+	bool fixed = flags & (MAP_FIXED | MAP_FIXED_NOREPLACE);
+	int error;
+
+	if ((flags & MAP_RESERVED_VA_MASK) && !(flags & MAP_RESERVED_VA))
+		return -EINVAL;
+	/* Check existence even when there is no address hint. */
+	if (vm_flags) {
+		unsigned int id = (flags & MAP_RESERVED_VA_MASK) >>
+				  MAP_RESERVED_VA_SHIFT;
+
+		error = reserved_va_check(current->mm, ranges[id].start, PAGE_SIZE,
+					  vm_flags);
+		if (error)
+			return error;
+		if (!fixed && len > ranges[id].end - ranges[id].start)
+			return -ENOMEM;
+	}
+	if (addr || fixed) {
+		error = reserved_va_check(current->mm, addr, len, vm_flags);
+		if (error && fixed)
+			return error;
+		if (error)
+			addr = 0;
+	}
+
+	/* Per-task, not per-mm: callbacks may sleep or nest, but not leak state. */
+	saved = current->reserved_va_flags;
+	current->reserved_va_flags = flags & (MAP_RESERVED_VA | MAP_RESERVED_VA_MASK);
+	ret = get_area(file, addr, len, pgoff, flags);
+	if (!IS_ERR_VALUE(ret) &&
+	    reserved_va_check(current->mm, ret, len, vm_flags)) {
+		if (!fixed)
+			ret = get_area(file, 0, len, pgoff, flags);
+		if (!IS_ERR_VALUE(ret) &&
+		    reserved_va_check(current->mm, ret, len, vm_flags))
+			ret = -EINVAL;
+	}
+	current->reserved_va_flags = saved;
+	return ret;
+}
+
+void reserved_va_prepare(struct vm_unmapped_area_info *info)
+{
+	unsigned long flags = current->reserved_va_flags;
+	unsigned int id;
+
+	if (!(flags & MAP_RESERVED_VA))
+		return;
+	id = (flags & MAP_RESERVED_VA_MASK) >> MAP_RESERVED_VA_SHIFT;
+	info->low_limit = ranges[id].start;
+	info->high_limit = ranges[id].end;
+}
+
+bool reserved_va_skip(struct vm_unmapped_area_info *info, unsigned long addr)
+{
+	int i;
+
+	if (!current->mm || (current->mm->context.flags & MMCF_AARCH32) ||
+	    (current->reserved_va_flags & MAP_RESERVED_VA))
+		return false;
+	for (i = 0; i < RESERVED_VA_NR; i++) {
+		if (addr < ranges[i].end && addr + info->length > ranges[i].start) {
+			if (info->flags & VM_UNMAPPED_AREA_TOPDOWN)
+				info->high_limit = ranges[i].start;
+			else
+				info->low_limit = ranges[i].end;
+			return true;
+		}
+	}
+	return false;
+}
+
+#if IS_ENABLED(CONFIG_RESERVED_USER_VA_KUNIT_TEST)
+static int boot_errors;
+
+/* Run before any DT registrations or userspace; leave no test reservations. */
+static int __init reserved_va_registration_test(void)
+{
+	struct reserved_va_range saved[RESERVED_VA_NR];
+	unsigned long base = 1UL << 32;
+
+	memcpy(saved, ranges, sizeof(saved));
+	memset(ranges, 0, sizeof(ranges));
+	boot_errors += reserved_va_register(0, base, base + PAGE_SIZE) != 0;
+	boot_errors += reserved_va_register(0, base, base + PAGE_SIZE) != -EEXIST;
+	boot_errors += reserved_va_register(1, base, base + PAGE_SIZE) != -EEXIST;
+	boot_errors += reserved_va_register(8, base, base + PAGE_SIZE) != -EINVAL;
+	boot_errors += reserved_va_register(1, base + 1, base + PAGE_SIZE) != -EINVAL;
+	boot_errors += reserved_va_register(1, base, base) != -EINVAL;
+	boot_errors += reserved_va_register(1, base, TASK_SIZE_64 + PAGE_SIZE) != -EINVAL;
+	boot_errors += reserved_va_register(1, base + PAGE_SIZE,
+					    base + 2 * PAGE_SIZE) != 0;
+	memcpy(ranges, saved, sizeof(saved));
+	return 0;
+}
+core_initcall(reserved_va_registration_test);
+
+static void reserved_va_test_range(unsigned int id, unsigned long *start,
+				   unsigned long *end)
+{
+	*start = id < RESERVED_VA_NR ? ranges[id].start : 0;
+	*end = id < RESERVED_VA_NR ? ranges[id].end : 0;
+}
+
+const struct reserved_va_test_ops reserved_va_test_ops = {
+	.register_range = reserved_va_register,
+	.check = reserved_va_check,
+	.vm_flags = reserved_va_vm_flags,
+	.map_flags = reserved_va_map_flags,
+	.get_area = reserved_va_get_area,
+	.alloc_mm = mm_alloc,
+	.unmapped_area = vm_unmapped_area,
+	.skip = reserved_va_skip,
+	.fork_thread = kernel_thread,
+	.exit_thread = do_exit,
+	.range = reserved_va_test_range,
+	.boot_errors = &boot_errors,
+};
+EXPORT_SYMBOL_GPL(reserved_va_test_ops);
+#endif
diff --git a/mm/reserved_va_test.c b/mm/reserved_va_test.c
new file mode 100644
index 000000000000..f3c4ee12567b
--- /dev/null
+++ b/mm/reserved_va_test.c
@@ -0,0 +1,405 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <kunit/test.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/kthread.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/reserved_va.h>
+#include <linux/sched/mm.h>
+
+#define ops reserved_va_test_ops
+
+static unsigned long range_start(unsigned int id)
+{
+	unsigned long start, end;
+
+	ops.range(id, &start, &end);
+	return start;
+}
+
+static int test_init(struct kunit *test)
+{
+	struct vm_unmapped_area_info info = { .length = PAGE_SIZE };
+	struct mm_struct *mm;
+
+	test->priv = NULL;
+	if (current->mm)
+		return -EINVAL;
+	KUNIT_EXPECT_FALSE(test, ops.skip(&info, 0));
+	mm = ops.alloc_mm();
+	if (!mm)
+		return -ENOMEM;
+	test->priv = mm;
+	return 0;
+}
+
+static void test_exit(struct kunit *test)
+{
+	if (test->priv) {
+		mmput(test->priv);
+		test->priv = NULL;
+	}
+}
+
+static void registration_body(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, *ops.boot_errors, 0);
+	KUNIT_EXPECT_EQ(test, ops.register_range(0, PAGE_SIZE, 2 * PAGE_SIZE),
+			-EPERM);
+}
+
+static void boundary_body(struct kunit *test)
+{
+	struct vm_unmapped_area_info info = { .length = PAGE_SIZE };
+	unsigned long start, end;
+	unsigned int id;
+
+	for (id = 0; id < RESERVED_VA_NR; id++) {
+		vm_flags_t flags = ops.vm_flags(MAP_RESERVED_VA_ID(id));
+
+		ops.range(id, &start, &end);
+		if (!end) {
+			KUNIT_EXPECT_EQ(test, ops.check(current->mm, PAGE_SIZE,
+							PAGE_SIZE, flags), -ENODEV);
+			continue;
+		}
+		KUNIT_EXPECT_EQ(test, ops.map_flags(flags),
+				(unsigned long)MAP_RESERVED_VA_ID(id));
+		KUNIT_EXPECT_EQ(test, ops.check(current->mm, start, end - start, flags), 0);
+		KUNIT_EXPECT_EQ(test, ops.check(current->mm, start, PAGE_SIZE, 0), -EINVAL);
+		KUNIT_EXPECT_EQ(test, ops.check(current->mm, start - PAGE_SIZE,
+						2 * PAGE_SIZE, flags), -EINVAL);
+		KUNIT_EXPECT_EQ(test, ops.check(current->mm, end - PAGE_SIZE,
+						2 * PAGE_SIZE, flags), -EINVAL);
+		KUNIT_EXPECT_EQ(test, ops.check(current->mm, ULONG_MAX - PAGE_SIZE,
+						2 * PAGE_SIZE, flags), -EINVAL);
+	}
+	KUNIT_EXPECT_EQ(test, ops.check(current->mm, 0, 0, 0), 0);
+	KUNIT_EXPECT_EQ(test, ops.check(current->mm, PAGE_SIZE, PAGE_SIZE,
+					15UL << VM_RESERVED_VA_SHIFT), -EINVAL);
+	ops.range(RESERVED_VA_NR, &start, &end);
+	KUNIT_EXPECT_EQ(test, start | end, 0UL);
+	current->mm->context.flags |= MMCF_AARCH32;
+	KUNIT_EXPECT_FALSE(test, ops.skip(&info, range_start(0)));
+	KUNIT_EXPECT_EQ(test, ops.check(current->mm, range_start(0), PAGE_SIZE, 0), 0);
+	KUNIT_EXPECT_EQ(test, ops.check(current->mm, range_start(0), PAGE_SIZE,
+					ops.vm_flags(MAP_RESERVED_VA_ID(0))), -EOPNOTSUPP);
+	current->mm->context.flags &= ~MMCF_AARCH32;
+}
+
+static unsigned long context_area(struct file *file, unsigned long addr,
+				  unsigned long len, unsigned long pgoff,
+				  unsigned long flags)
+{
+	struct kunit *test = file->private_data;
+
+	KUNIT_EXPECT_EQ(test, current->reserved_va_flags,
+			flags & MAP_RESERVED_VA_FLAGS);
+	usleep_range(1000, 2000);
+	if (pgoff == 1)
+		return -EIO;
+	if (pgoff == 2)
+		return PAGE_SIZE;
+	if (pgoff == 3 && addr)
+		return PAGE_SIZE;
+	if (pgoff == 4)
+		return addr ? PAGE_SIZE : -EIO;
+	return range_start((flags & MAP_RESERVED_VA_MASK) >> MAP_RESERVED_VA_SHIFT);
+}
+
+static unsigned long nested_area(struct file *file, unsigned long addr,
+				 unsigned long len, unsigned long pgoff,
+				 unsigned long flags)
+{
+	struct kunit *test = file->private_data;
+	unsigned long ret;
+
+	ret = ops.get_area(context_area, file, 0, len, 0, MAP_RESERVED_VA_ID(1));
+	KUNIT_EXPECT_EQ(test, ret, range_start(1));
+	KUNIT_EXPECT_EQ(test, current->reserved_va_flags,
+			(unsigned long)MAP_RESERVED_VA_ID(0));
+	return range_start(0);
+}
+
+static void context_body(struct kunit *test)
+{
+	struct file file = { .private_data = test };
+	unsigned long ret, saved = MAP_RESERVED_VA_ID(7);
+	int i;
+
+	current->reserved_va_flags = saved;
+	for (i = 0; i < 3; i++) {
+		ret = ops.get_area(context_area, &file, 0, PAGE_SIZE, i,
+				   MAP_RESERVED_VA_ID(0));
+		KUNIT_EXPECT_EQ(test, ret, i == 0 ? range_start(0) :
+				(unsigned long)(i == 1 ? -EIO : -EINVAL));
+		KUNIT_EXPECT_EQ(test, current->reserved_va_flags, saved);
+	}
+	ret = ops.get_area(nested_area, &file, 0, PAGE_SIZE, 0, MAP_RESERVED_VA_ID(0));
+	KUNIT_EXPECT_EQ(test, ret, range_start(0));
+	KUNIT_EXPECT_EQ(test, current->reserved_va_flags, saved);
+	ret = ops.get_area(context_area, &file, range_start(0), PAGE_SIZE, 4,
+			   MAP_RESERVED_VA_ID(0));
+	KUNIT_EXPECT_EQ(test, ret, (unsigned long)-EIO);
+	KUNIT_EXPECT_EQ(test, current->reserved_va_flags, saved);
+	ret = ops.get_area(context_area, &file, range_start(0), PAGE_SIZE, 3,
+			   MAP_RESERVED_VA_ID(0));
+	KUNIT_EXPECT_EQ(test, ret, range_start(0));
+	KUNIT_EXPECT_EQ(test, current->reserved_va_flags, saved);
+}
+
+static void search_body(struct kunit *test)
+{
+	struct vm_unmapped_area_info info = {};
+	unsigned long start, end, ret;
+	int direction;
+
+	ops.range(0, &start, &end);
+	KUNIT_EXPECT_NE(test, end, 0UL);
+	if (!end)
+		return;
+	mmap_write_lock(current->mm);
+	for (direction = 0; direction < 2; direction++) {
+		info.flags = direction ? VM_UNMAPPED_AREA_TOPDOWN : 0;
+		info.low_limit = start - PAGE_SIZE;
+		info.high_limit = end + PAGE_SIZE;
+		info.length = PAGE_SIZE;
+		ret = ops.unmapped_area(&info);
+		KUNIT_EXPECT_EQ(test, ret, direction ? end : start - PAGE_SIZE);
+		info.low_limit = start;
+		info.high_limit = end;
+		KUNIT_EXPECT_EQ(test, ops.unmapped_area(&info), (unsigned long)-ENOMEM);
+		current->reserved_va_flags = MAP_RESERVED_VA_ID(0);
+		info.align_mask = 4 * PAGE_SIZE - 1;
+		info.align_offset = PAGE_SIZE;
+		ret = ops.unmapped_area(&info);
+		KUNIT_EXPECT_GE(test, ret, start);
+		KUNIT_EXPECT_LE(test, ret + PAGE_SIZE, end);
+		KUNIT_EXPECT_EQ(test, ret & info.align_mask, info.align_offset);
+		current->reserved_va_flags = 0;
+		info.align_mask = 0;
+		info.align_offset = 0;
+	}
+	/* A single candidate straddles several adjacent numbered intervals. */
+	info.flags = 0;
+	info.low_limit = range_start(0);
+	info.high_limit = range_start(2) + PAGE_SIZE;
+	info.length = range_start(1) - range_start(0) + PAGE_SIZE;
+	KUNIT_EXPECT_EQ(test, ops.unmapped_area(&info), (unsigned long)-ENOMEM);
+	info.flags = VM_UNMAPPED_AREA_TOPDOWN;
+	KUNIT_EXPECT_EQ(test, ops.unmapped_area(&info), (unsigned long)-ENOMEM);
+	mmap_write_unlock(current->mm);
+}
+
+struct worker {
+	struct completion done;
+	unsigned int id;
+	int error;
+};
+
+static unsigned long worker_area(struct file *file, unsigned long addr,
+				 unsigned long len, unsigned long pgoff,
+				 unsigned long flags)
+{
+	struct worker *worker = file->private_data;
+
+	msleep(20);
+	if (current->reserved_va_flags != MAP_RESERVED_VA_ID(worker->id))
+		worker->error++;
+	return range_start(worker->id);
+}
+
+static int context_worker(void *data)
+{
+	struct worker *worker = data;
+	struct mm_struct *mm = ops.alloc_mm();
+	struct file file = { .private_data = worker };
+	unsigned long ret;
+
+	if (current->reserved_va_flags)
+		worker->error++;
+	if (!mm) {
+		worker->error++;
+		goto done;
+	}
+	kthread_use_mm(mm);
+	ret = ops.get_area(worker_area, &file, 0, PAGE_SIZE, 0,
+			   MAP_RESERVED_VA_ID(worker->id));
+	if (ret != range_start(worker->id) || current->reserved_va_flags)
+		worker->error++;
+	kthread_unuse_mm(mm);
+	mmput(mm);
+done:
+	complete(&worker->done);
+	return 0;
+}
+
+static int inheritance_worker(void *data)
+{
+	struct worker *worker = data;
+
+	worker->error = !!current->reserved_va_flags;
+	complete(&worker->done);
+	/* A raw kernel_thread callback must exit, never fall into ret_to_user. */
+	ops.exit_thread(0);
+	return 0;
+}
+
+static void concurrent_context_body(struct kunit *test)
+{
+	struct worker workers[2] = {};
+	struct task_struct *tasks[2];
+	struct worker inherited = {};
+	pid_t pid;
+	int i;
+
+	/* Force nonzero inheritance input to exercise sched_fork clearing. */
+	init_completion(&inherited.done);
+	current->reserved_va_flags = MAP_RESERVED_VA_ID(7);
+	pid = ops.fork_thread(inheritance_worker, &inherited, "reserved-va-fork", 0);
+	current->reserved_va_flags = 0;
+	KUNIT_EXPECT_GT(test, pid, 0);
+	if (pid > 0) {
+		wait_for_completion(&inherited.done);
+		KUNIT_EXPECT_EQ(test, inherited.error, 0);
+	}
+	for (i = 0; i < 2; i++) {
+		init_completion(&workers[i].done);
+		workers[i].id = i;
+		tasks[i] = kthread_run(context_worker, &workers[i], "reserved-va-test");
+	}
+	current->reserved_va_flags = 0;
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_FALSE(test, IS_ERR(tasks[i]));
+		if (!IS_ERR(tasks[i])) {
+			wait_for_completion(&workers[i].done);
+			KUNIT_EXPECT_EQ(test, workers[i].error, 0);
+		}
+	}
+}
+
+/* KUnit cleanup runs in another task: borrow and release in the test task. */
+static void run_with_mm(struct kunit *test, void (*body)(struct kunit *test))
+{
+	kthread_use_mm(test->priv);
+	/* Bodies use nonfatal expectations so every return reaches unuse_mm. */
+	body(test);
+	current->reserved_va_flags = 0;
+	kthread_unuse_mm(test->priv);
+}
+
+static void registration_test(struct kunit *test)
+{
+	run_with_mm(test, registration_body);
+}
+
+static void boundary_test(struct kunit *test)
+{
+	run_with_mm(test, boundary_body);
+}
+
+static void context_test(struct kunit *test)
+{
+	run_with_mm(test, context_body);
+}
+
+static void search_test(struct kunit *test)
+{
+	run_with_mm(test, search_body);
+}
+
+static void concurrent_context_test(struct kunit *test)
+{
+	run_with_mm(test, concurrent_context_body);
+}
+
+static struct kunit_case reserved_va_cases[] = {
+	KUNIT_CASE(registration_test),
+	KUNIT_CASE(boundary_test),
+	KUNIT_CASE(context_test),
+	KUNIT_CASE(search_test),
+	KUNIT_CASE(concurrent_context_test),
+	{}
+};
+
+static struct kunit_suite reserved_va_suite = {
+	.name = "reserved-user-va",
+	.init = test_init,
+	.exit = test_exit,
+	.test_cases = reserved_va_cases,
+};
+
+kunit_test_suite(reserved_va_suite);
+
+static struct page *device_page;
+
+static unsigned long device_area(struct file *file, unsigned long addr,
+				 unsigned long len, unsigned long pgoff,
+				 unsigned long flags)
+{
+	if (pgoff == 1)
+		return -EIO;
+	if (pgoff == 2)
+		return PAGE_SIZE;
+	if (pgoff == 4 && addr)
+		return PAGE_SIZE;
+	if (pgoff == 5)
+		return range_start(0) + 1;
+	return current->mm->get_unmapped_area(file, addr, len, pgoff, flags);
+}
+
+static int device_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	if (vma->vm_end - vma->vm_start != PAGE_SIZE)
+		return -EINVAL;
+	if (vma->vm_pgoff == 3)
+		vm_flags_clear(vma, VM_RESERVED_VA_MASK);
+	if (vma->vm_pgoff == 6) {
+		vma->vm_start = PAGE_SIZE;
+		return 0;
+	}
+	if (vma->vm_pgoff == 7) {
+		vma->vm_end += PAGE_SIZE;
+		return 0;
+	}
+	vm_flags_set(vma, VM_MIXEDMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	return vm_insert_page(vma, vma->vm_start, device_page);
+}
+
+static const struct file_operations device_fops = {
+	.owner = THIS_MODULE,
+	.mmap = device_mmap,
+	.get_unmapped_area = device_area,
+};
+
+static struct miscdevice device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "reserved-va-test",
+	.fops = &device_fops,
+};
+
+static int __init reserved_va_test_init(void)
+{
+	int ret;
+
+	device_page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!device_page)
+		return -ENOMEM;
+	ret = misc_register(&device);
+	if (ret)
+		__free_page(device_page);
+	return ret;
+}
+
+static void __exit reserved_va_test_exit(void)
+{
+	misc_deregister(&device);
+	__free_page(device_page);
+}
+
+module_init(reserved_va_test_init);
+module_exit(reserved_va_test_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Reserved user virtual address tests");
diff --git a/drivers/of/reserved_user_va.c b/drivers/of/reserved_user_va.c
new file mode 100644
index 000000000000..7e7204e05e26
--- /dev/null
+++ b/drivers/of/reserved_user_va.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0
+#define pr_fmt(fmt) "reserved-user-va: " fmt
+
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/overflow.h>
+#include <linux/reserved_va.h>
+
+static int __init register_range(struct device_node *node)
+{
+	const __be32 *id_prop, *range_prop;
+	u64 range[2], end;
+	u32 id;
+	int len;
+
+	id_prop = of_get_property(node, "range-id", &len);
+	if (!id_prop || len != sizeof(id))
+		return -EINVAL;
+	range_prop = of_get_property(node, "virtual-range", &len);
+	if (!range_prop || len != sizeof(range))
+		return -EINVAL;
+	id = be32_to_cpup(id_prop);
+	range[0] = of_read_number(range_prop, 2);
+	range[1] = of_read_number(range_prop + 2, 2);
+	if (!range[1] || check_add_overflow(range[0], range[1], &end) ||
+	    end > ULONG_MAX)
+		return -EINVAL;
+	return reserved_va_register(id, range[0], end);
+}
+
+static int __init reserved_user_va_init(void)
+{
+	struct device_node *parent, *child;
+
+	for_each_compatible_node(parent, NULL, "openeuler,reserved-user-va") {
+		if (!of_device_is_available(parent))
+			continue;
+		for_each_available_child_of_node(parent, child) {
+			int ret = register_range(child);
+
+			if (ret)
+				pr_err("%pOF: registration failed: %d\n", child, ret);
+			else
+				pr_info("%pOF: registered\n", child);
+		}
+	}
+	return 0;
+}
+subsys_initcall(reserved_user_va_init);
