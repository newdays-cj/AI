diff --git a/include/linux/reserved_va.h b/include/linux/reserved_va.h
new file mode 100644
index 000000000000..46a274d89c0a
--- /dev/null
+++ b/include/linux/reserved_va.h
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_RESERVED_VA_H
+#define _LINUX_RESERVED_VA_H
+
+#include <linux/errno.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+
+typedef unsigned long (*reserved_va_get_area_t)(struct file *, unsigned long,
+		unsigned long, unsigned long, unsigned long);
+
+#define RESERVED_VA_NR	8
+
+#ifdef CONFIG_RESERVED_USER_VA
+int reserved_va_register(unsigned int id, unsigned long start, unsigned long end);
+int reserved_va_check(struct mm_struct *mm, unsigned long start,
+		      unsigned long len, vm_flags_t flags);
+vm_flags_t reserved_va_vm_flags(unsigned long flags);
+unsigned long reserved_va_map_flags(vm_flags_t flags);
+unsigned long reserved_va_get_area(reserved_va_get_area_t get_area,
+				   struct file *file, unsigned long addr,
+				   unsigned long len, unsigned long pgoff,
+				   unsigned long flags);
+void reserved_va_prepare(struct vm_unmapped_area_info *info);
+bool reserved_va_skip(struct vm_unmapped_area_info *info, unsigned long addr);
+
+#if IS_ENABLED(CONFIG_RESERVED_USER_VA_KUNIT_TEST)
+/* Test-only bridge; production registration is deliberately not exported. */
+struct reserved_va_test_ops {
+	int (*register_range)(unsigned int id, unsigned long start, unsigned long end);
+	int (*check)(struct mm_struct *mm, unsigned long start, unsigned long len,
+		     vm_flags_t flags);
+	vm_flags_t (*vm_flags)(unsigned long flags);
+	unsigned long (*map_flags)(vm_flags_t flags);
+	unsigned long (*get_area)(reserved_va_get_area_t get_area, struct file *file,
+				  unsigned long addr, unsigned long len,
+				  unsigned long pgoff, unsigned long flags);
+	struct mm_struct *(*alloc_mm)(void);
+	unsigned long (*unmapped_area)(struct vm_unmapped_area_info *info);
+	bool (*skip)(struct vm_unmapped_area_info *info, unsigned long addr);
+	pid_t (*fork_thread)(int (*fn)(void *), void *arg, const char *name,
+			     unsigned long flags);
+	void (*exit_thread)(long code) __noreturn;
+	void (*range)(unsigned int id, unsigned long *start, unsigned long *end);
+	int *boot_errors;
+};
+
+extern const struct reserved_va_test_ops reserved_va_test_ops;
+#endif
+#else
+static inline int reserved_va_register(unsigned int id, unsigned long start,
+				       unsigned long end)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline int reserved_va_check(struct mm_struct *mm, unsigned long start,
+				    unsigned long len, vm_flags_t flags)
+{
+	return 0;
+}
+
+static inline vm_flags_t reserved_va_vm_flags(unsigned long flags)
+{
+	return 0;
+}
+
+static inline unsigned long reserved_va_map_flags(vm_flags_t flags)
+{
+	return 0;
+}
+
+static inline unsigned long reserved_va_get_area(reserved_va_get_area_t get_area,
+						 struct file *file, unsigned long addr,
+						 unsigned long len, unsigned long pgoff,
+						 unsigned long flags)
+{
+#ifdef MAP_RESERVED_VA
+	if (flags & (MAP_RESERVED_VA | MAP_RESERVED_VA_MASK))
+		return -EOPNOTSUPP;
+#endif
+	return get_area(file, addr, len, pgoff, flags);
+}
+
+static inline void reserved_va_prepare(struct vm_unmapped_area_info *info) {}
+static inline bool reserved_va_skip(struct vm_unmapped_area_info *info,
+				    unsigned long addr)
+{
+	return false;
+}
+#endif
+#endif /* _LINUX_RESERVED_VA_H */
